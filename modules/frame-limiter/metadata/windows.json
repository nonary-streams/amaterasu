{
  "descriptor": {
    "provider": "amaterasu.frame-limiter",
    "display_name": "Frame limiting",
    "revision": 1,
    "options": [
      {
        "id": "frame_limiter_enable",
        "label": "Enable frame limiting",
        "help": "Limit games launched during a streaming session. Start a new application session after saving.",
        "definition": {
          "type": "boolean",
          "default": false
        },
        "presentation": null,
        "allowed_scopes": [
          "host",
          "application",
          "paired_client",
          "session"
        ],
        "apply_policy": "next_stream",
        "required_capabilities": []
      },
      {
        "id": "frame_limiter_provider",
        "label": "Limiter",
        "help": "Automatic uses Proton for limiting and MangoHUD for the overlay when available.",
        "definition": {
          "type": "enum",
          "default": "auto",
          "options": [
            "auto",
            "rtss",
            "nvidia-control-panel",
            "none"
          ]
        },
        "choice_labels": {
          "auto": "Automatic",
          "none": "Disabled",
          "nvidia-control-panel": "NVIDIA driver",
          "rtss": "RTSS"
        },
        "presentation": null,
        "allowed_scopes": [
          "host",
          "application",
          "paired_client",
          "session"
        ],
        "apply_policy": "next_stream",
        "required_capabilities": []
      },
      {
        "id": "frame_limiter_fps_limit",
        "label": "Frame rate limit (FPS)",
        "help": "Use 0 to follow the client display or stream rate. For example: 60 or 59.94.",
        "definition": {
          "type": "decimal",
          "default": 0.0,
          "minimum": 0.0,
          "maximum": 1000.0
        },
        "presentation": null,
        "allowed_scopes": [
          "host",
          "application",
          "paired_client",
          "session"
        ],
        "apply_policy": "next_stream",
        "required_capabilities": []
      },
      {
        "id": "rtss_frame_limit_type",
        "label": "RTSS timing",
        "help": "Choose how RTSS paces frames.",
        "definition": {
          "type": "enum",
          "default": "async",
          "options": [
            "async",
            "front edge sync",
            "back edge sync",
            "nvidia reflex"
          ]
        },
        "presentation": null,
        "allowed_scopes": [
          "host",
          "application",
          "paired_client",
          "session"
        ],
        "apply_policy": "next_stream",
        "required_capabilities": []
      },
      {
        "id": "rtss_install_path",
        "label": "RTSS installation folder",
        "help": "Leave blank to find the installed RTSS copy automatically.",
        "definition": {
          "type": "string",
          "default": "",
          "min_length": 0,
          "max_length": 1024
        },
        "presentation": null,
        "allowed_scopes": [
          "host"
        ],
        "apply_policy": "next_stream",
        "required_capabilities": []
      },
      {
        "id": "rtss_allow_virtual_display_override",
        "label": "Override RTSS timing for virtual displays",
        "help": "Allow automatic timing selection for virtual displays.",
        "definition": {
          "type": "boolean",
          "default": false
        },
        "presentation": null,
        "allowed_scopes": [
          "host"
        ],
        "apply_policy": "next_stream",
        "required_capabilities": []
      },
      {
        "id": "frame_limiter_auto_virtual_framegen",
        "label": "Automatic frame-generation limiting",
        "help": "Apply frame limiting automatically when supported frame generation is configured.",
        "definition": {
          "type": "enum",
          "default": "enabled",
          "options": [
            "enabled",
            "vrr",
            "legacy",
            "disabled"
          ]
        },
        "choice_labels": {
          "disabled": "Disabled",
          "enabled": "Enabled",
          "legacy": "Legacy mode",
          "vrr": "Variable refresh rate"
        },
        "presentation": null,
        "allowed_scopes": [
          "host",
          "application",
          "paired_client",
          "session"
        ],
        "apply_policy": "next_stream",
        "required_capabilities": []
      },
      {
        "id": "frame_limiter_disable_vsync",
        "label": "Disable VSync",
        "help": "Turn off driver VSync while streaming, then restore it afterward.",
        "definition": {
          "type": "boolean",
          "default": false
        },
        "presentation": null,
        "allowed_scopes": [
          "host",
          "application",
          "paired_client",
          "session"
        ],
        "apply_policy": "next_stream",
        "required_capabilities": []
      }
    ],
    "actions": [],
    "capabilities": [
      "nonary.frame-limiter.windows"
    ],
