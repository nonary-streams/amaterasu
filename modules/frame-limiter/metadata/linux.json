{
  "descriptor": {
    "provider": "amaterasu.frame-limiter",
    "display_name": "Frame limiting",
    "revision": 1,
    "options": [
      {
        "id": "frame_limiter_enable",
        "label": "Enable frame limiting",
        "help": "Limit games launched during a streaming session. Start a new application session after saving.",
        "definition": {
          "type": "boolean",
          "default": false
        },
        "presentation": null,
        "allowed_scopes": [
          "host",
          "application",
          "paired_client",
          "session"
        ],
        "apply_policy": "next_stream",
        "required_capabilities": []
      },
      {
        "id": "frame_limiter_provider",
        "label": "Limiter",
        "help": "Automatic uses Proton for limiting and MangoHUD for the overlay when available.",
        "definition": {
          "type": "enum",
          "default": "auto",
          "options": [
            "auto",
            "mangohud",
            "proton",
            "mangohud-proton",
            "none"
          ]
        },
        "choice_labels": {
          "auto": "Automatic",
          "mangohud": "MangoHUD",
          "mangohud-proton": "Proton + MangoHUD",
          "none": "Disabled",
          "proton": "Proton"
        },
        "presentation": null,
        "allowed_scopes": [
          "host",
          "application",
          "paired_client",
          "session"
        ],
        "apply_policy": "next_stream",
        "required_capabilities": []
      },
      {
        "id": "frame_limiter_fps_limit",
        "label": "Frame rate limit (FPS)",
        "help": "Use 0 to follow the client display or stream rate. For example: 60 or 59.94.",
        "definition": {
          "type": "decimal",
          "default": 0.0,
          "minimum": 0.0,
          "maximum": 1000.0
        },
        "presentation": null,
        "allowed_scopes": [
          "host",
          "application",
          "paired_client",
          "session"
        ],
        "apply_policy": "next_stream",
        "required_capabilities": []
      },
      {
        "id": "mangohud_preset",
        "label": "MangoHUD appearance",
        "help": "Use your existing MangoHUD configuration, or choose a built-in overlay preset.",
        "definition": {
          "type": "enum",
          "default": "custom",
          "options": [
            "custom",
            "1",
            "2",
            "3",
            "4"
          ]
        },
        "choice_labels": {
          "1": "Preset 1",
          "2": "Preset 2",
          "3": "Preset 3",
          "4": "Preset 4",
          "custom": "My MangoHUD configuration"
        },
        "presentation": null,
        "allowed_scopes": [
          "host"
        ],
        "apply_policy": "next_stream",
        "required_capabilities": []
      },
      {
        "id": "mangohud_always_show_graph",
        "label": "Show frame-time graph",
        "help": "Show the frame-time graph in the MangoHUD overlay.",
        "definition": {
          "type": "boolean",
          "default": false
        },
        "presentation": null,
        "allowed_scopes": [
          "host"
        ],
        "apply_policy": "next_stream",
        "required_capabilities": []
      },
      {
        "id": "mangohud_limiter_method",
        "label": "MangoHUD timing",
        "help": "Early favors smooth pacing; late favors lower input latency. Used when MangoHUD limits the game.",
        "definition": {
          "type": "enum",
          "default": "late",
          "options": [
            "early",
            "late"
          ]
        },
        "choice_labels": {
          "early": "Smooth pacing (early)",
          "late": "Lower latency (late)"
        },
        "presentation": null,
        "allowed_scopes": [
          "host"
        ],
        "apply_policy": "next_stream",
        "required_capabilities": []
      },
      {
        "id": "frame_limiter_auto_virtual_framegen",
        "label": "Automatic frame-generation limiting",
        "help": "Apply frame limiting automatically when supported frame generation is configured.",
        "definition": {
          "type": "enum",
          "default": "enabled",
          "options": [
            "enabled",
            "vrr",
            "legacy",
            "disabled"
          ]
        },
        "choice_labels": {
          "disabled": "Disabled",
          "enabled": "Enabled",
          "legacy": "Legacy mode",
          "vrr": "Variable refresh rate"
        },
        "presentation": null,
        "allowed_scopes": [
          "host",
          "application",
          "paired_client",
          "session"
        ],
        "apply_policy": "next_stream",
        "required_capabilities": []
      },
      {
        "id": "frame_limiter_disable_vsync",
        "label": "Disable VSync",
        "help": "MangoHUD and Proton cannot change VSync. Leave this off and configure VSync in the game.",
        "definition": {
          "type": "boolean",
          "default": false
        },
        "presentation": null,
        "allowed_scopes": [
          "host",
          "application",
          "paired_client",
          "session"
        ],
        "apply_policy": "next_stream",
        "required_capabilities": []
      }
    ],
    "actions": [],
    "capabilities": [
      "amaterasu.launch-environment"
    ],
