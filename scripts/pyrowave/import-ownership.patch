+
+// Amaterasu requires failure-preserving DMA-BUF import ownership semantics.
+extern "C" PYROWAVE_PUBLIC_API uint32_t pyrowave_amaterasu_import_fd_contract_v1()
+{
+	return 1;
+}
+
+// Flush queued library command buffers before proving borrowed input retired.
+extern "C" PYROWAVE_PUBLIC_API void pyrowave_amaterasu_wait_idle_v1(pyrowave_device device)
+{
+	device->device.wait_idle();
+}
+
+// Exercise the GPU conversion and encoder without any CPU pixel upload. This
+// qualifies the device path; importing a particular capture allocation remains
+// a separate operation and may still fail.
+extern "C" PYROWAVE_PUBLIC_API pyrowave_result
+pyrowave_amaterasu_probe_v1(pyrowave_encoder encoder, bool hdr, size_t budget)
+{
+    if (!encoder || !budget)
+        return PYROWAVE_ERROR_INVALID_ARGUMENT;
+    auto *device = encoder->device;
+    auto info = ImageCreateInfo::immutable_2d_image(
+        encoder->width, encoder->height,
+        hdr ? VK_FORMAT_A2B10G10R10_UNORM_PACK32 : VK_FORMAT_R8G8B8A8_UNORM);
+    info.initial_layout = VK_IMAGE_LAYOUT_UNDEFINED;
+    info.layout = ImageLayout::General;
+    info.usage |= VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    auto image = device->create_image(info);
+    if (!image)
+        return PYROWAVE_ERROR_OUT_OF_DEVICE_MEMORY;
+    auto cmd = device->request_command_buffer(encoder->pyro_device->queue_type);
+    cmd->image_barrier(*image, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL,
+                      VK_PIPELINE_STAGE_2_NONE, 0,
+                      VK_PIPELINE_STAGE_2_CLEAR_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT);
+    VkClearValue value = {};
+    value.color.float32[0] = value.color.float32[1] = value.color.float32[2] = 0.75f;
+    value.color.float32[3] = 1.0f;
+    cmd->clear_image(*image, value);
+    cmd->image_barrier(*image, VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_GENERAL,
+                      VK_PIPELINE_STAGE_2_CLEAR_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+                      VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT, VK_ACCESS_2_SHADER_SAMPLED_READ_BIT);
+    device->submit(cmd);
+    pyrowave_scaled_encode_info scaling = {};
+    scaling.view.image = image->get_image();
+    scaling.view.width = encoder->width;
+    scaling.view.height = encoder->height;
+    scaling.view.image_format = scaling.view.view_format = info.format;
+    scaling.view.layout = VK_IMAGE_LAYOUT_GENERAL;
+    scaling.view.aspect = VK_IMAGE_ASPECT_COLOR_BIT;
+    scaling.view.swizzle = VK_COMPONENT_SWIZZLE_IDENTITY;
+    scaling.input_color_space = scaling.output_color_space =
+        hdr ? VK_COLOR_SPACE_HDR10_ST2084_EXT : VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+    scaling.intermediate_plane_format = hdr ? VK_FORMAT_R16_UNORM : VK_FORMAT_R8_UNORM;
+    scaling.ycbcr_chroma_midpoint = hdr ? 512.0f / 1023.0f : 128.0f / 255.0f;
+    scaling.skip_dither = true;
+    pyrowave_rate_control rate = {};
+    rate.maximum_bitstream_size = budget;
+    auto result = pyrowave_encoder_encode_gpu_scaled_synchronous(encoder, nullptr, nullptr, &scaling, &rate);
+    device->wait_idle();
+    return result;
+}
