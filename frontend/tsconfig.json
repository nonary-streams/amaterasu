    "src/rtx_hdr.ts",
    "src/integrations.ts",
    "src/updates.ts",
    "src/locale.ts",
    "src/live_streams.ts",
    "src/stream_controls.ts",
    "src/host_metrics.ts",
    "src/updater.ts",
    "src/system_tray.ts",
    "src/host_logs.ts",
    "src/session_history.ts",
    "src/session_timeline.ts",
    "src/pages.ts",
    "src/permission-management.ts",
    "src/management.ts",
    "src/accounts.ts",
    "src/tokens.ts",
