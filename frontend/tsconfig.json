{
  "compilerOptions": {
    "target": "ES2022",
    "module": "none",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outFile": "dist/app.js",
    "removeComments": true,
    "forceConsistentCasingInFileNames": true
  },
  "files": [
    "src/types.ts",
    "src/model.ts",
    "src/api.ts",
    "src/ui.ts",
    "src/catalog.ts",
    "src/settings.ts",
    "src/pages.ts",
    "src/app.ts"
  ]
}
